# Copy to .env and fill in. Everything is optional, and nothing here needs a credit card.

# OneMap (Singapore Land Authority): free account at https://www.onemap.gov.sg/apidocs/register
# Needed for bus/MRT itineraries. Without it the app falls back to walking-only routes.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# OpenRouteService: free key at https://openrouteservice.org/dev/#/signup
# Used for walking-only routes if OneMap isn't configured. Without it the public OSRM demo server is used.
ORS_API_KEY=

# data.gov.sg: optional key that raises the rate limit (https://guide.data.gov.sg/developer-guide/api-overview/api-rate-limits)
DATA_GOV_SG_API_KEY=

PORT=3000
